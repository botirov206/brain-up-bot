# Brain-Up bot environment.
# Copy this file to .env and fill in real values:
#   cp example.env .env
# .env is gitignored. Do not commit tokens or database passwords.
# .env.example lists the same keys without these notes.

# Bot token from @BotFather in Telegram.
# 1. Open Telegram and start a chat with @BotFather (the verified bot).
# 2. Send /newbot.
# 3. Enter a display name (for example Brain-Up).
# 4. Enter a username that ends with "bot" (for example BrainUpPotok1Bot).
# 5. BotFather replies with an HTTP API token. Paste it here.
# It looks like 123456789:AAH-example-token
BOT_TOKEN=

# Neon Postgres connection string. Use the pooled string.
# 1. Open https://console.neon.tech and sign in (or create an account).
# 2. Click New Project. Name it, pick a region close to the VPS, click Create.
# 3. On the project page, click Connect (the connection-string panel).
# 4. Enable Connection pooling (pooled). The host usually contains "-pooler".
# 5. Copy the connection string and paste it here. It starts with postgresql://
# and should include sslmode=require. The bot turns on TLS when it sees that.
DATABASE_URL=

# Numeric id of the Brain-Up Поток-1 Telegram group. Supergroup ids are negative,
# like -1001234567890. Not the group name, and not an @username.
# 1. Add the bot to the group Brain-Up Поток-1.
# 2. Make the bot a group admin so it can send messages (and delete its own
#    placeholder line if a round video fails to forward). Minimum: post messages.
# 3. Read the id by any one of these:
#    A. Forward any message from the group to @userinfobot. It replies with the
#       group chat id. Paste that number here.
#    B. Add @RawDataBot to the group, send a message, and copy the chat id from
#       the raw update it prints. Then remove @RawDataBot.
#    C. After the bot is in the group and someone sends a command it can see,
#       from your machine (do not share the output; the URL contains the token):
#         curl -s "https://api.telegram.org/bot$BOT_TOKEN/getUpdates"
#       Find "chat":{"id":-100...} for the group.
GROUP_CHAT_ID=

# Comma-separated numeric Telegram user ids of admins. No @usernames.
# Example: 111111111,222222222
# Get your own id: open @userinfobot, send /start, copy the Id number.
# These ids are marked admin when they press /start, and they can use
# /settings, /topics, /topicadd, /report, and /members.
ADMIN_TELEGRAM_IDS=

# Username BotFather assigned in the /newbot step, without the @.
# Example: if the link is https://t.me/BrainUpPotok1Bot then the value is BrainUpPotok1Bot.
# Used for the morning button: https://t.me/<BOT_USERNAME>?start=wake
BOT_USERNAME=

# IANA timezone for "today" and the daily schedule. The group is in Tashkent.
# Leave this as Asia/Tashkent unless the whole group moves.
TIMEZONE=Asia/Tashkent
