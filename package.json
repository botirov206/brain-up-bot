{
  "name": "brain-up-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Daily Brain-Up challenge bot for a Telegram group",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^18.0.4",
    "grammy": "^1.46.0",
    "node-cron": "^4.6.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
